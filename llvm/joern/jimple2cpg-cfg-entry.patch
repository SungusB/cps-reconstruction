+  /** EXPERIMENT: the first node evaluated in a statement (first AST child, recursively), so that a jump into the
+    * statement also evaluates its operands. Linking to the root skips them and loses their reaching definitions.
+    */
+  private def cfgEntry(ast: Ast): NewNode = {
+    def go(n: NewNode): NewNode = ast.edges.find(_.src == n) match {
+      case Some(e) => go(e.dst)
+      case None    => n
+    }
+    go(ast.root.get)
+  }
